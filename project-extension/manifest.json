{
    "name": "Protect your tabs",
    "description": "An extension via which individual domains like gmail,whatsapp can be locked with password",
    "version": "1.0",
    "manifest_version": 3,
    "action": {
      
    },
    "permissions": [
        "storage","activeTab","tabs"
      ],
      "background": {
        "type":"module",
        "service_worker": "background.js"
      }
      ,
      "content_scripts": [
        {
          "js": ["scripts/content.js"],
          "matches": ["<all_urls>"]
        }
      ]
  }
  